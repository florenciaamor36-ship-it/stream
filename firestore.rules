rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    // Preserve the active legacy grants exactly; existing Android behavior/data stay intact.
    match /usuarios/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
    match /tokens_usados/{token} {
      allow read, write: if request.auth != null;
    }

    // Minimal web-compatible records only. Credentials, PINs, nested profiles,
    // and all fields not explicitly listed below remain local-only / denied.
    function ownsSafeAccount(uid) {
      return request.resource.data.keys().hasAll(['userId'])
        && request.resource.data.keys().hasOnly([
          'userId', 'platform', 'customPlatformName', 'providerId', 'providerName',
          'cost', 'totalProfiles', 'isFullAccount', 'isFullAccountSold',
          'purchaseDate', 'renewalDate', 'notes', 'createdAt', 'updatedAt'
        ])
        && request.resource.data.userId == uid;
    }
    function ownsSafeSale(uid) {
      return request.resource.data.keys().hasAll(['userId'])
        && request.resource.data.keys().hasOnly([
          'userId', 'type', 'accountId', 'profileId', 'profileName', 'customerId',
          'customerName', 'customerPhone', 'platform', 'salePrice', 'costPrice',
          'profit', 'startDate', 'endDate', 'status', 'paymentStatus',
          'paymentMethod', 'notes', 'lastRenewalDate', 'createdAt', 'updatedAt'
        ])
        && request.resource.data.userId == uid;
    }
    function ownsSafeClient(uid) {
      return request.resource.data.keys().hasAll(['userId', 'name', 'phone'])
        && request.resource.data.keys().hasOnly([
          'userId', 'name', 'phone', 'email', 'notes', 'createdAt', 'updatedAt'
        ])
        && request.resource.data.userId == uid;
    }

    match /users/{uid}/accounts/{documentId} {
      allow read, delete: if isOwner(uid);
      allow create, update: if isOwner(uid) && ownsSafeAccount(uid);
    }
    match /users/{uid}/sales/{documentId} {
      allow read, delete: if isOwner(uid);
      allow create, update: if isOwner(uid) && ownsSafeSale(uid);
    }
    match /users/{uid}/clients/{documentId} {
      allow read, delete: if isOwner(uid);
      allow create, update: if isOwner(uid) && ownsSafeClient(uid);
    }

    // Default deny for every other namespace and collection.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
